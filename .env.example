# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Optional local-only UI preview. Production always requires Shopify.
ENABLE_LOCAL_CATALOG_FALLBACK=false

# Legacy VTBSJMYH_SHOPIFY_* names remain supported for existing deployments.

# Shopify hosted Customer Accounts (public account destination, not a secret)
SHOPIFY_CUSTOMER_ACCOUNT_URL=https://your-shopify-hosted-customer-account-url
