# Temporary Auth.js fallback ? do not remove until Shopify Customer Accounts is verified
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_SECRET=generate-a-long-random-secret

# Shopify Storefront API
VTBSJMYH_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VTBSJMYH_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Shopify Customer Accounts (server-only)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-customer-account-client-id
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=your-customer-account-client-secret
SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=generate-a-long-random-secret
SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_URL=https://house-of-aristocrat.vercel.app/api/customer-auth/callback
NEXT_PUBLIC_SITE_URL=https://house-of-aristocrat.vercel.app
